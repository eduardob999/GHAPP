{
  "name": "guitar-practice-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline-first PWA practice companion for guitar: fretting shapes, picking-hand accuracy, and theory.",
  "scripts": {
    "predev": "node scripts/setup-config.mjs",
    "dev": "vite",
    "prebuild": "node scripts/setup-config.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "ship": "node scripts/ship.mjs"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "pitchy": "^4.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
