rules_version = '2';

// Publish with: firebase deploy --only firestore:rules
// Or paste into the Firebase console under Firestore Database -> Rules.
//
// The whole data model is keyed by uid, so the rule is simply "you may touch
// your own document and nothing else". Signing into the same Google account on
// another device yields the same uid, which is what makes progress follow you.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Future subcollections (/skills, /sessions) inherit the same ownership
      // check rather than needing a new rule each time.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Released 2026-11-20 with his go-ahead. The previous release was rulesets/0ef397f2-7b3b-4a36-a1f0-0f7b5f9ee589 (users-only rules); to roll back,
    // release that ruleset again. The household rules were exercised against the live project with throwaway users before use.
    // Households (Nexo Kaji): a small shared space for the people who live together. `members` maps uid to a role
    // ('owner' or 'member'). Only members read or write inside it. The owner adds people by writing an invite keyed by the
    // invitee's verified Google address; the invitee then adds only their own uid, with the role the invite names.
    function isMember(hid) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }
    function isOwner(hid) {
      return request.auth != null
        && get(/databases/$(database)/documents/households/$(hid)).data.members[request.auth.uid] == 'owner';
    }

    match /households/{hid} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner';
      allow update: if request.auth != null && (
        resource.data.members[request.auth.uid] == 'owner'
        || (
          request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/households/$(hid)/invites/$(request.auth.token.email.lower()))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'langs'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('names', {}).diff(resource.data.get('names', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('langs', {}).diff(resource.data.get('langs', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid]
             == get(/databases/$(database)/documents/households/$(hid)/invites/$(request.auth.token.email.lower())).data.role
        ));
      allow delete: if false;

      // Invites: the owner writes them; the invitee can read their own to see it exists.
      match /invites/{email} {
        allow read: if request.auth != null && (isOwner(hid) || request.auth.token.email.lower() == email);
        allow create, update, delete: if isOwner(hid) && request.resource.data.role in ['member'];
        allow delete: if isOwner(hid);
      }

      // The log is append-only: a member may add an event, take back one they made, and later fill in the ratings and comment of their own. Nothing else is rewritten.
      match /log/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid);
        allow delete: if isMember(hid) && resource.data.uid == request.auth.uid;
        // The doer may add or change how it went, later: the ratings and the comment, nothing else.
        allow update: if isMember(hid) && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['effort', 'dislike', 'enjoyment', 'note', 'ratedAt']);
      }
      // The change history of the setup is append-only too.
      match /history/{id} {
        allow read: if isMember(hid);
        allow create: if isMember(hid);
      }
      // Calendar busy times are written by the Nexo service with the admin key; members only read them.
      match /busy/{id} {
        allow read: if isMember(hid);
      }
      // Everything else in the household (chores, survey, plan, settings, away, swaps) is editable by both of them.
      match /{sub}/{id} {
        allow read, write: if isMember(hid) && sub in ['tasks', 'survey', 'plan', 'settings', 'away', 'swaps', 'requests', 'lists', 'listitems', 'ledger', 'asks'];
      }
    }

    // Anything not matched above is denied.
  }
}
